+/* R28-TL5D-T2-PHASESPLIT (MEASUREMENT-ONLY, reverted before any ship
+ * claim): env-gated solve-vs-emit phase timers for the L0-encode
+ * warmed-gap split. LZMESH_PHASESPLIT=1 enables; LZMESH_PHASELOG=path
+ * selects the dump file (default stderr). Covers u35_emit_inner
+ * (single-block) + u36m walker (multi-block) L0 paths only. */
+#include <time.h>
+static unsigned long long t2_ph_solve = 0ull;
+static unsigned long long t2_ph_emit = 0ull;
+static unsigned long long t2_ph_n = 0ull;
+static int t2_ph_en = -1;
+static unsigned long long t2_ph_now(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (unsigned long long)ts.tv_sec * 1000000000ull +
+        (unsigned long long)ts.tv_nsec;
+}
+static int t2_ph_on(void) {
+    if (t2_ph_en < 0) {
+        const char *e = getenv("LZMESH_PHASESPLIT");
+        t2_ph_en = (e && e[0] == '1') ? 1 : 0;
+    }
+    return t2_ph_en;
+}
+__attribute__((destructor)) static void t2_ph_dump(void) {
+    if (t2_ph_en == 1) {
+        const char *p = getenv("LZMESH_PHASELOG");
+        FILE *f = p ? fopen(p, "a") : NULL;
+        if (!f)
+            f = stderr;
+        fprintf(f, "PHASESPLIT solve=%llu emit=%llu n=%llu\n", t2_ph_solve,
+            t2_ph_emit, t2_ph_n);
+        if (f != stderr)
+            fclose(f);
+    }
+}
