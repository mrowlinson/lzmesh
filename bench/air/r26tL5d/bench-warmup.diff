+/* R24-WARM: pre-registered inner warmup count (symmetric enc+dec untimed
+ * uses per cell per run, AFTER the baseline warmup that pins eret0).
+ * BENCH_INNER_WARMUP unset/invalid -> 1 (loop runs 0x: byte-identical
+ * behavior, gated). k=7: timed rep1 = 8th use (past plateau). */
+static unsigned inner_warmup(void)
+{
+	const char *e = getenv("BENCH_INNER_WARMUP");
+	long k;
+	if (!e || !*e)
+		return 1u;
+	k = atol(e);
+	if (k < 1 || k > 64)
+		return 1u;
+	return (unsigned)k;
+}
